<?xml version="1.0" encoding="utf-8"?>
<!--
  Vorschau im Widget-Auswahlmenü.

  Zeigt dieselbe Anordnung wie das fertige Widget in seiner größten Stufe -
  nur mit Beispielwerten, weil zur Auswahlzeit noch kein Sparziel feststeht.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_preview_icon_circle"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_widget_goal"
            android:tint="@color/widget_preview_on_container" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_name"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_percent"
            android:textColor="@color/widget_preview_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_preview_saved"
        android:textColor="@color/widget_preview_on_surface"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_target"
        android:textColor="@color/widget_preview_on_surface_variant"
        android:textSize="12sp" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="40"
        android:progressDrawable="@drawable/widget_preview_progress" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_preview_remaining"
        android:textColor="@color/widget_preview_on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
