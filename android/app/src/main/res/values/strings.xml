<?xml version="1.0" encoding="utf-8"?>
<!--
  Texte rund um das Homescreen-Widget.

  Die Beschriftungen *im* Widget liefert die App mit den Daten mit, damit
  Widget und App dieselbe Sprache sprechen (siehe HomeWidgetTexts). Was hier
  steht, greift nur in zwei Fällen:

    * Name und Beschreibung im Widget-Auswahlmenü sowie die Vorschau - die
      zeigt Android, bevor die App je lief.
    * Als Rückfall, solange nach der Installation noch nichts übertragen
      wurde.

  Englisch ist - wie bei den ARB-Dateien der App - die Ausgangssprache;
  values-de enthält die deutsche Fassung.
-->
<resources>
    <string name="widget_label">Savings goal</string>
    <string name="widget_description">Shows how far along one of your savings goals is.</string>
    <string name="widget_ring_label">Savings goal (compact)</string>
    <string name="widget_ring_description">Shows one savings goal as a progress ring.</string>

    <string name="widget_hint_pick_goal">Tap to choose a savings goal</string>
    <string name="widget_hint_no_data">Open Spartracker to get started</string>

    <string name="widget_config_title">Choose savings goal</string>
    <string name="widget_config_confirm">Apply</string>
    <string name="widget_config_cancel">Cancel</string>
    <string name="widget_config_empty_title">No savings goals yet</string>
    <string name="widget_config_empty_body">Create a savings goal in the app first, then it will show up here.</string>
    <string name="widget_config_open_app">Open app</string>

    <!-- Sample values for the preview in the widget picker. -->
    <string name="widget_preview_name">New bike</string>
    <string name="widget_preview_percent">40 %</string>
    <string name="widget_preview_saved">€320.00</string>
    <string name="widget_preview_target">of €800.00</string>
    <string name="widget_preview_remaining">€480.00 to go</string>
</resources>
